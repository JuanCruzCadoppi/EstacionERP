<Window x:Class="EstacionERP.Desktop.Views.CambiarPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar contraseña"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Fuente}"
        Background="{StaticResource ColorFondo}"
        FocusManager.FocusedElement="{Binding ElementName=TxtActual}">
    <Border Style="{StaticResource Tarjeta}" Margin="24" Padding="24">
        <StackPanel>
            <TextBlock Text="Cambiar contraseña" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource ColorTexto}" />
            <TextBlock x:Name="TxtAviso" Style="{StaticResource TextoSuave}" Margin="0,4,0,8"
                       Text="Por seguridad tenés que elegir una contraseña nueva antes de continuar." />

            <TextBlock Style="{StaticResource Etiqueta}" Text="Contraseña actual" />
            <PasswordBox x:Name="TxtActual" FontSize="13" Padding="6,5" />

            <TextBlock Style="{StaticResource Etiqueta}" Text="Nueva contraseña (mínimo 6 caracteres)" />
            <PasswordBox x:Name="TxtNueva" FontSize="13" Padding="6,5" />

            <TextBlock Style="{StaticResource Etiqueta}" Text="Repetir nueva contraseña" />
            <PasswordBox x:Name="TxtConfirmacion" FontSize="13" Padding="6,5" />

            <TextBlock Text="{Binding Error}" Foreground="{StaticResource ColorError}" TextWrapping="Wrap"
                       FontSize="12" Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource BotonSecundario}" Content="Cancelar" IsCancel="True" />
                <Button Style="{StaticResource BotonPrimario}" Content="Guardar" IsDefault="True" Margin="0"
                        Click="AlGuardar" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
