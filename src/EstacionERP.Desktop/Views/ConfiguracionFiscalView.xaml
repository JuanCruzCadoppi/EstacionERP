<UserControl x:Class="EstacionERP.Desktop.Views.ConfiguracionFiscalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="AlCargar">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TituloPagina}" Text="Configuración fiscal (ARCA)" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0,4,0,16" TextWrapping="Wrap"
                       Text="Seguí los pasos en orden: 1) datos de la empresa, 2) certificado digital, 3) puntos de venta. Mientras el entorno sea Homologación, las facturas son de prueba y no tienen validez fiscal." />

            <!-- 1. Datos de la empresa -->
            <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Subtitulo}" Text="1. Datos de la empresa" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Etiqueta}" Text="CUIT *" />
                            <TextBox Text="{Binding Cuit}" />
                            <TextBlock Style="{StaticResource Etiqueta}" Text="Razón social *" />
                            <TextBox Text="{Binding RazonSocial}" />
                            <TextBlock Style="{StaticResource Etiqueta}" Text="Nombre de fantasía" />
                            <TextBox Text="{Binding NombreFantasia}" />
                            <TextBlock Style="{StaticResource Etiqueta}" Text="Condición frente al IVA *" />
                            <ComboBox ItemsSource="{Binding CondicionesEmisor}" DisplayMemberPath="Texto" SelectedValuePath="Valor"
                                      SelectedValue="{Binding CondicionIva}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Etiqueta}" Text="Domicilio comercial" />
                            <TextBox Text="{Binding Domicilio}" />
                            <TextBlock Style="{StaticResource Etiqueta}" Text="Localidad" />
                            <TextBox Text="{Binding Localidad}" />
                            <TextBlock Style="{StaticResource Etiqueta}" Text="Ingresos Brutos" />
                            <TextBox Text="{Binding IngresosBrutos}" />
                            <TextBlock Style="{StaticResource Etiqueta}" Text="Inicio de actividades" />
                            <DatePicker SelectedDate="{Binding InicioActividades}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Etiqueta}" Text="Entorno de ARCA" />
                    <ComboBox Width="260" HorizontalAlignment="Left" ItemsSource="{Binding Entornos}" DisplayMemberPath="Texto"
                              SelectedValuePath="Valor" SelectedValue="{Binding Entorno}" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource BotonPrimario}" Content="Guardar datos" Command="{Binding GuardarDatosCommand}" />
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" Text="{Binding MensajeDatos}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. Certificado -->
            <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Subtitulo}" Text="2. Certificado digital" />
                    <TextBlock Style="{StaticResource TextoSuave}" Margin="0,4,0,8" TextWrapping="Wrap"
                               Text="El programa genera la clave privada (queda guardada en la base, nunca sale de acá) y una solicitud. Esa solicitud se pega en ARCA, que devuelve el certificado. La guía completa está en docs/ARCA-Homologacion.md." />
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding EstadoCertificado}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="200" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource Etiqueta}" Text="Alias (nombre del certificado)" />
                            <TextBox Text="{Binding Alias}" />
                        </StackPanel>
                        <Button Style="{StaticResource BotonSecundario}" Content="A. Generar solicitud (.csr)" VerticalAlignment="Bottom"
                                Command="{Binding GenerarSolicitudCommand}" />
                        <Button Style="{StaticResource BotonSecundario}" Content="B. Importar certificado (.crt)" VerticalAlignment="Bottom"
                                Command="{Binding ImportarCertificadoCommand}" />
                        <Button Style="{StaticResource BotonPrimario}" Content="C. Probar conexión" VerticalAlignment="Bottom"
                                Command="{Binding ProbarConexionCommand}" />
                    </StackPanel>
                    <TextBox Margin="0,12,0,0" MinHeight="70" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                             Text="{Binding ResultadoPrueba}" />
                </StackPanel>
            </Border>

            <!-- 3. Puntos de venta -->
            <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Subtitulo}" Text="3. Puntos de venta" />
                    <TextBlock Style="{StaticResource TextoSuave}" Margin="0,4,0,8" TextWrapping="Wrap"
                               Text="Cada unidad de negocio factura con su propio punto de venta (tipo &quot;RECE - Web Services&quot; dado de alta en ARCA). En homologación podés usar cualquier número, por ejemplo 1, 2 y 3." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <DataGrid Grid.Column="0" MinHeight="140" ItemsSource="{Binding PuntosVenta}" SelectedItem="{Binding PuntoSeleccionado}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="N°" Binding="{Binding Numero, StringFormat=D4}" Width="60" />
                                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" />
                                <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadNegocio}" Width="130" />
                                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Etiqueta}" Text="Número" />
                            <TextBox Text="{Binding PvNumero}" />
                            <TextBlock Style="{StaticResource Etiqueta}" Text="Descripción" />
                            <TextBox Text="{Binding PvDescripcion}" />
                            <TextBlock Style="{StaticResource Etiqueta}" Text="Unidad de negocio" />
                            <ComboBox ItemsSource="{Binding Unidades}" DisplayMemberPath="Texto" SelectedValuePath="Valor"
                                      SelectedValue="{Binding PvUnidadId}" />
                            <CheckBox Content="Activo" IsChecked="{Binding PvActivo}" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource BotonSecundario}" Content="Nuevo" Command="{Binding NuevoPuntoCommand}" />
                                <Button Style="{StaticResource BotonPrimario}" Content="Guardar" Command="{Binding GuardarPuntoCommand}" />
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding MensajePv}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
