<Window x:Class="EstacionERP.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estación ERP - Ingresar"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Fuente}"
        Background="{StaticResource ColorFondo}"
        FocusManager.FocusedElement="{Binding ElementName=TxtUsuario}">
    <Border Style="{StaticResource Tarjeta}" Margin="24" Padding="24">
        <StackPanel>
            <TextBlock Text="Estación ERP" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource ColorTexto}" />
            <TextBlock Text="Ingresá con tu usuario" Style="{StaticResource TextoSuave}" Margin="0,4,0,8" />

            <TextBlock Style="{StaticResource Etiqueta}" Text="Usuario" />
            <TextBox x:Name="TxtUsuario" Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{StaticResource Etiqueta}" Text="Contraseña" />
            <PasswordBox x:Name="TxtPassword" FontSize="13" Padding="6,5" />

            <TextBlock Text="{Binding Error}" Foreground="{StaticResource ColorError}" TextWrapping="Wrap"
                       FontSize="12" Margin="0,10,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Style="{StaticResource BotonSecundario}" Content="Salir" IsCancel="True" />
                <Button Style="{StaticResource BotonPrimario}" Content="Ingresar" IsDefault="True" Margin="0"
                        Click="AlIngresar" IsEnabled="{Binding Ocupado, Converter={StaticResource Negar}}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
