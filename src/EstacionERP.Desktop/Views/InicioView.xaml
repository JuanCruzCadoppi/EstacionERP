<UserControl x:Class="EstacionERP.Desktop.Views.InicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="AlCargar">
    <StackPanel>
        <TextBlock Style="{StaticResource TituloPagina}" Text="Inicio" />
        <TextBlock Style="{StaticResource TextoSuave}" Text="{Binding Fecha}" Margin="0,4,0,0" />

        <TextBlock Style="{StaticResource Subtitulo}" Text="Unidades de negocio" Margin="0,24,0,10" />
        <ItemsControl ItemsSource="{Binding Unidades}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Tarjeta}" Width="240" Margin="0,0,14,14">
                        <StackPanel>
                            <TextBlock Text="{Binding Codigo}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource ColorPrimario}" />
                            <TextBlock Text="{Binding Nombre}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"
                                       Foreground="{StaticResource ColorTexto}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource Tarjeta}" Width="240" HorizontalAlignment="Left" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="CLIENTES ACTIVOS" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTextoSuave}" />
                <TextBlock Text="{Binding CantidadClientes}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"
                           Foreground="{StaticResource ColorTexto}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
