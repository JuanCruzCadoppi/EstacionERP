<UserControl x:Class="EstacionERP.Desktop.Views.ProximamenteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource TituloPagina}" Text="{Binding Titulo}" />
        <Border Style="{StaticResource Tarjeta}" Margin="0,18,0,0" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Style="{StaticResource Subtitulo}" Text="Módulo en construcción" />
                <TextBlock Style="{StaticResource TextoSuave}" Margin="0,6,0,0" Text="{Binding Descripcion}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
