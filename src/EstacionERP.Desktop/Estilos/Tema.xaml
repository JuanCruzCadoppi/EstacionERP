<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Colores ===== -->
    <SolidColorBrush x:Key="ColorFondo" Color="#F4F5F7" />
    <SolidColorBrush x:Key="ColorSuperficie" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ColorBorde" Color="#DDE1E6" />
    <SolidColorBrush x:Key="ColorTexto" Color="#1F2933" />
    <SolidColorBrush x:Key="ColorTextoSuave" Color="#616E7C" />
    <SolidColorBrush x:Key="ColorPrimario" Color="#0B6E4F" />
    <SolidColorBrush x:Key="ColorPrimarioHover" Color="#09573F" />
    <SolidColorBrush x:Key="ColorMenu" Color="#1B2631" />
    <SolidColorBrush x:Key="ColorMenuHover" Color="#2C3E50" />
    <SolidColorBrush x:Key="ColorMenuActivo" Color="#0B6E4F" />
    <SolidColorBrush x:Key="ColorError" Color="#B42318" />
    <SolidColorBrush x:Key="ColorErrorFondo" Color="#FEF3F2" />
    <SolidColorBrush x:Key="ColorFilaAlterna" Color="#F9FAFB" />
    <SolidColorBrush x:Key="ColorSeleccion" Color="#D8EFE6" />

    <FontFamily x:Key="Fuente">Segoe UI</FontFamily>

    <!-- ===== Textos ===== -->
    <Style x:Key="TituloPagina" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    </Style>

    <Style x:Key="Subtitulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    </Style>

    <Style x:Key="Etiqueta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextoSuave}" />
        <Setter Property="Margin" Value="0,10,0,3" />
    </Style>

    <Style x:Key="TextoSuave" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextoSuave}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===== Tarjeta ===== -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ColorSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ===== Botones ===== -->
    <Style x:Key="BotonBase" TargetType="Button">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource ColorPrimario}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorPrimario}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorPrimarioHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EEF0F2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Menú lateral (RadioButton con aspecto de ítem de menú) ===== -->
    <Style x:Key="ItemMenu" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#D5DBE1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="GroupName" Value="Menu" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fondo" Background="Transparent" Padding="20,10" Margin="8,1" CornerRadius="6">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource ColorMenuHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource ColorMenuActivo}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SeccionMenu" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#7B8794" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="28,18,0,6" />
    </Style>

    <!-- ===== Campos ===== -->
    <Style TargetType="TextBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="6,5" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    </Style>

    <!-- ===== Grilla ===== -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ColorBorde}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource ColorFilaAlterna}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="RowHeight" Value="32" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#EEF0F2" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextoSuave}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorSeleccion}" />
                <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolAVisibilidad" />
</ResourceDictionary>
