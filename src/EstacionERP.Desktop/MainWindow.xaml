<Window x:Class="EstacionERP.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estación ERP"
        Width="1280" Height="780" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Fuente}"
        Background="{StaticResource ColorFondo}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Menú lateral ===== -->
        <Border Grid.Column="0" Background="{StaticResource ColorMenu}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="24,22,16,10">
                    <TextBlock Text="Estación ERP" Foreground="White" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Laguna Larga" Foreground="#7B8794" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Usuario conectado -->
                <Border DockPanel.Dock="Bottom" BorderBrush="#2C3E50" BorderThickness="0,1,0,0" Padding="24,12,16,14">
                    <StackPanel>
                        <TextBlock Text="{Binding UsuarioNombre}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding UsuarioRol}" Foreground="#7B8794" FontSize="11" Margin="0,1,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12" Margin="0,0,14,0">
                                <Hyperlink Foreground="#9AA5B1" Click="AlCambiarPassword">Contraseña</Hyperlink>
                            </TextBlock>
                            <TextBlock FontSize="12">
                                <Hyperlink Foreground="#9AA5B1" Command="{Binding CerrarSesionCommand}">Cerrar sesión</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="v0.2 · Etapa 1" Foreground="#52606D" FontSize="11" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <RadioButton Style="{StaticResource ItemMenu}" Content="Inicio" IsChecked="True"
                                     Command="{Binding NavegarCommand}" CommandParameter="Inicio" />

                        <TextBlock Style="{StaticResource SeccionMenu}" Text="NEGOCIOS" />
                        <RadioButton Style="{StaticResource ItemMenu}" Content="Playa / Combustibles"
                                     Command="{Binding NavegarCommand}" CommandParameter="Playa"
                                     Visibility="{Binding VerPlaya, Converter={StaticResource BoolAVisibilidad}}" />
                        <RadioButton Style="{StaticResource ItemMenu}" Content="Repuestos"
                                     Command="{Binding NavegarCommand}" CommandParameter="Repuestos"
                                     Visibility="{Binding VerRepuestos, Converter={StaticResource BoolAVisibilidad}}" />
                        <RadioButton Style="{StaticResource ItemMenu}" Content="Lavadero"
                                     Command="{Binding NavegarCommand}" CommandParameter="Lavadero"
                                     Visibility="{Binding VerLavadero, Converter={StaticResource BoolAVisibilidad}}" />

                        <TextBlock Style="{StaticResource SeccionMenu}" Text="GESTIÓN" />
                        <RadioButton Style="{StaticResource ItemMenu}" Content="Clientes"
                                     Command="{Binding NavegarCommand}" CommandParameter="Clientes" />
                        <RadioButton Style="{StaticResource ItemMenu}" Content="Productos"
                                     Command="{Binding NavegarCommand}" CommandParameter="Productos" />
                        <RadioButton Style="{StaticResource ItemMenu}" Content="Cuentas corrientes"
                                     Command="{Binding NavegarCommand}" CommandParameter="CuentasCorrientes" />
                        <RadioButton Style="{StaticResource ItemMenu}" Content="Caja"
                                     Command="{Binding NavegarCommand}" CommandParameter="Caja" />
                        <RadioButton Style="{StaticResource ItemMenu}" Content="Facturación ARCA"
                                     Visibility="{Binding VerFacturacion, Converter={StaticResource BoolAVisibilidad}}"
                                     Command="{Binding NavegarCommand}" CommandParameter="Facturacion" />

                        <StackPanel Visibility="{Binding VerAdministracion, Converter={StaticResource BoolAVisibilidad}}">
                            <TextBlock Style="{StaticResource SeccionMenu}" Text="ADMINISTRACIÓN" />
                            <RadioButton Style="{StaticResource ItemMenu}" Content="Usuarios"
                                         Visibility="{Binding VerUsuarios, Converter={StaticResource BoolAVisibilidad}}"
                                         Command="{Binding NavegarCommand}" CommandParameter="Usuarios" />
                            <RadioButton Style="{StaticResource ItemMenu}" Content="Configuración fiscal"
                                         Visibility="{Binding VerConfiguracionFiscal, Converter={StaticResource BoolAVisibilidad}}"
                                         Command="{Binding NavegarCommand}" CommandParameter="ConfiguracionFiscal" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Contenido ===== -->
        <ContentControl Grid.Column="1" Content="{Binding VistaActual}" Margin="28,24,28,20" />
    </Grid>
</Window>
